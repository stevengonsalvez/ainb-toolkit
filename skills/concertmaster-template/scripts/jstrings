#!/usr/bin/env python3
# Print every string in an Orca JSON reply, one per line. Tolerates lone UTF-16 surrogates that make jq fail.
import sys
sys.path.pop(0)  # never import a planted module from the script directory
import json
raw = sys.stdin.buffer.read().decode("utf-8", "replace")
try:
    d = json.loads(raw, strict=False)
except Exception:
    sys.exit(0)
out = []
def walk(o):
    if isinstance(o, str): out.append(o)
    elif isinstance(o, dict):
        for v in o.values(): walk(v)
    elif isinstance(o, list):
        for v in o: walk(v)
walk(d)
sys.stdout.write("\n".join(out).encode("utf-8", "replace").decode("utf-8") + "\n")
