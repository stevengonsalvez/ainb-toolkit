#!/usr/bin/env python3
"""Generate the Backstage catalogue for the QE agent pack.

Reads packages/qe-agent-pack/apm.yml, the .apm tree and eval-score.json, and
writes two generated files next to them:

  catalog-info.yaml               one AiResource per skill and per agent, one
                                  API (type mcp-server) per MCP dependency,
                                  one System for the pack
  .well-known/skills/index.json   the Backstage skills index convention

Usage:
  scripts/generate-backstage-catalog             regenerate both files
  scripts/generate-backstage-catalog --check     exit 1 if either file drifts

Provenance: every entity carries backstage.io/source-location pointing at the
last commit that touched the pack sources (apm.yml, .apm/, eval-score.json),
so the URL resolves to the exact bytes the entity describes. Regeneration
therefore expects those sources to be committed first; pass --allow-dirty to
override, or --sha to skip git entirely (tests do this on throwaway copies).

--check does not derive the sha: it reads the one in the committed
catalog-info.yaml, requires that commit to exist and the pack sources to be
byte-identical to it, then compares the regenerated output. That keeps the
check independent of how CI checks out a pull request (a merge ref is never
the answer) and means the pinned commit must survive the merge: merge with a
merge commit, since a squash or rebase merge rewrites it and every URL 404s.

Only the standard library plus PyYAML (already in tests/requirements-test.txt).
"""

from __future__ import annotations

import argparse
import difflib
import json
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

import yaml

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_PACK = REPO_ROOT / "packages" / "qe-agent-pack"

# Supplied values: everything below is authored here, not derived from the pack.
LIFECYCLE = "experimental"
DISCIPLINES = ["quality-engineering"]
SKILL_CATEGORIES = ["testing"]
AGENT_CATEGORIES = ["agent", "testing"]
# APM target slug -> Backstage AiResource spec.agents value.
TARGET_TO_AGENT = {"claude": "claude-code", "copilot": "github-copilot"}
ANNOTATION_PREFIX = "wololo.dev"
GENERATED_HEADER = (
    "# Generated by scripts/generate-backstage-catalog. Do not edit by hand.\n"
    "# Regenerate after changing apm.yml, .apm/ or eval-score.json; CI runs\n"
    "# the --check form and fails on drift.\n"
)

# Sources whose last commit is the provenance sha. Relative to the pack dir.
PROVENANCE_SOURCES = ["apm.yml", ".apm", "eval-score.json"]

REQUIRED_METRICS = ("mutation_kill_rate", "seeded_defects_caught")
VERDICTS = ("PASS", "REGRESSION", "REFUSED")
MCP_TOOL_RE = re.compile(r"\bmcp__([A-Za-z0-9_-]+?)__")
SHA_RE = re.compile(r"[0-9a-f]{40}")
SOURCE_LOCATION_RE = re.compile(r"backstage\.io/source-location: url:\S+/(?:tree|blob)/([0-9a-f]{40})/")


class GenerateError(Exception):
    """A source file is missing or malformed."""


def read_frontmatter(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        raise GenerateError(f"{path}: no YAML frontmatter")
    end = text.find("\n---", 4)
    if end < 0:
        raise GenerateError(f"{path}: unterminated frontmatter")
    data = yaml.safe_load(text[4:end])
    if not isinstance(data, dict) or "name" not in data or "description" not in data:
        raise GenerateError(f"{path}: frontmatter needs name and description")
    return data


def load_eval_score(path: Path) -> dict:
    if not path.is_file():
        raise GenerateError(f"{path}: missing eval score file")
    data = json.loads(path.read_text(encoding="utf-8"))
    for key in ("pack", "source", "recorded", "verdict", "metrics"):
        if key not in data:
            raise GenerateError(f"{path}: missing key {key!r}")
    if not str(data["source"]).startswith("https://"):
        raise GenerateError(f"{path}: source must be an https URL")
    try:
        date.fromisoformat(data["recorded"])
    except (TypeError, ValueError) as exc:
        raise GenerateError(f"{path}: recorded must be an ISO date") from exc
    if data["verdict"] not in VERDICTS:
        raise GenerateError(f"{path}: verdict must be one of {VERDICTS}")
    metrics = data["metrics"]
    if not isinstance(metrics, dict) or not metrics:
        raise GenerateError(f"{path}: metrics must be a non-empty object")
    for name in REQUIRED_METRICS:
        if name not in metrics:
            raise GenerateError(f"{path}: metrics must include {name!r}")
    for name, value in metrics.items():
        if not isinstance(value, dict) or "candidate" not in value:
            raise GenerateError(f"{path}: metric {name!r} needs a candidate value")
        for arm, score in value.items():
            if not isinstance(score, (int, float)) or isinstance(score, bool) or not 0 <= score <= 1:
                raise GenerateError(f"{path}: metric {name!r} {arm} must be a number in [0, 1]")
    # A PASS verdict is only claimable when every guarded signal held its baseline.
    regressed = [
        name for name in REQUIRED_METRICS
        if metrics[name]["candidate"] < metrics[name].get("baseline", 0)
    ]
    if data["verdict"] == "PASS" and regressed:
        raise GenerateError(f"{path}: verdict PASS but candidate below baseline on {regressed}")
    return data


def git(root: Path, *args: str) -> str:
    result = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        raise GenerateError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout.strip()


def resolve_sha(pack: Path, allow_dirty: bool) -> str:
    """Sha for a fresh generation: the last commit touching the pack sources."""
    sources = [str(pack / s) for s in PROVENANCE_SOURCES]
    if not allow_dirty:
        dirty = git(pack, "status", "--porcelain", "--", *sources)
        if dirty:
            raise GenerateError(
                "pack sources have uncommitted changes, so the source-location sha "
                "would not resolve to them; commit first or pass --allow-dirty:\n" + dirty
            )
    sha = git(pack, "log", "-1", "--format=%H", "--", *sources)
    if not SHA_RE.fullmatch(sha):
        raise GenerateError("could not resolve a commit touching the pack sources")
    return sha


def committed_sha(pack: Path) -> str:
    """Sha for --check: the one already pinned in the committed catalogue."""
    catalog = pack / "catalog-info.yaml"
    if not catalog.is_file():
        raise GenerateError(f"{catalog}: missing; run the generator first")
    found = set(SOURCE_LOCATION_RE.findall(catalog.read_text(encoding="utf-8")))
    if len(found) != 1:
        raise GenerateError(f"{catalog}: expected one provenance sha, found {sorted(found)}")
    return found.pop()


def verify_sources_match_sha(pack: Path, sha: str) -> None:
    """The pinned commit must exist and hold exactly the pack sources on disk."""
    sources = [str(pack / s) for s in PROVENANCE_SOURCES]
    if subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=pack,
                      capture_output=True).returncode != 0:
        raise GenerateError(
            f"provenance commit {sha} is not in this repository; the pack was probably "
            "squash or rebase merged, regenerate against a reachable commit"
        )
    diff = subprocess.run(["git", "diff", "--stat", sha, "--", *sources], cwd=pack,
                          capture_output=True, text=True)
    if diff.returncode != 0:
        raise GenerateError(f"git diff against {sha}: {diff.stderr.strip()}")
    if diff.stdout.strip():
        raise GenerateError(
            f"pack sources differ from provenance commit {sha[:12]}; regenerate:\n{diff.stdout}"
        )


def eval_annotation(score: dict) -> str:
    payload = {
        "metrics": score["metrics"],
        "recorded": score["recorded"],
        "source": score["source"],
        "verdict": score["verdict"],
    }
    return json.dumps(payload, sort_keys=True, separators=(",", ":"))


def eval_summary(score: dict) -> str:
    kill = score["metrics"]["mutation_kill_rate"]
    caught = score["metrics"]["seeded_defects_caught"]
    return (
        f"Eval gate {score['verdict']} on {score['recorded']}: mutation kill rate "
        f"{kill['candidate']:.4f} (baseline {kill.get('baseline', 0):.4f}), "
        f"seeded-defect catch {caught['candidate']:.4f} "
        f"(baseline {caught.get('baseline', 0):.4f})."
    )


def list_files(root: Path) -> list[str]:
    """Files git would commit under root: tracked plus untracked and not ignored.

    Falls back to a directory walk when root is not inside a repository, which
    is the case for the throwaway copies the tests generate into.
    """
    listing = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "."],
        cwd=root, capture_output=True, text=True,
    )
    if listing.returncode == 0:
        return sorted(f for f in listing.stdout.split("\0") if f and (root / f).is_file())
    return sorted(
        p.relative_to(root).as_posix() for p in root.rglob("*") if p.is_file()
    )


def pack_relative_path(pack: Path) -> str:
    """Path of the pack inside the repository, as used in source-location URLs."""
    try:
        return pack.resolve().relative_to(REPO_ROOT).as_posix()
    except ValueError as exc:
        raise GenerateError(f"{pack} is outside {REPO_ROOT}; pass --pack-rel") from exc


class Catalog:
    def __init__(self, pack: Path, sha: str, pack_rel: str | None = None) -> None:
        self.pack = pack
        self.sha = sha
        self.apm = yaml.safe_load((pack / "apm.yml").read_text(encoding="utf-8"))
        for key in ("name", "version", "description", "author", "repository"):
            if key not in self.apm:
                raise GenerateError(f"apm.yml: missing key {key!r}")
        self.score = load_eval_score(pack / "eval-score.json")
        if self.score["pack"] != self.apm["name"]:
            raise GenerateError("eval-score.json pack does not match apm.yml name")
        self.repo_url = str(self.apm["repository"]).rstrip("/")
        self.pack_rel = pack_rel or pack_relative_path(pack)
        self.owner = f"user:{self.apm['author']}"
        self.system = self.apm["name"]
        self.tags = list(self.apm.get("keywords", []))
        targets = list(self.apm.get("targets") or [])
        unknown_targets = [t for t in targets if t not in TARGET_TO_AGENT]
        if unknown_targets:
            raise GenerateError(f"apm.yml: targets not mapped to Backstage agents: {unknown_targets}")
        self.agents = [TARGET_TO_AGENT[t] for t in targets]
        self.mcp_servers = {}
        for dep in (self.apm.get("dependencies") or {}).get("mcp") or []:
            if not isinstance(dep, dict) or not dep.get("name"):
                raise GenerateError("apm.yml: every dependencies.mcp entry needs a name")
            self.mcp_servers[dep["name"]] = dep

    # Provenance helpers ---------------------------------------------------

    def source_url(self, rel: str, is_dir: bool) -> str:
        kind = "tree" if is_dir else "blob"
        path = f"{self.pack_rel}/{rel}" if rel else self.pack_rel
        suffix = "/" if is_dir else ""
        return f"{self.repo_url}/{kind}/{self.sha}/{path}{suffix}"

    def source_location(self, rel: str, is_dir: bool) -> str:
        return "url:" + self.source_url(rel, is_dir)

    def annotations(self, rel: str, is_dir: bool, **extra: str) -> dict:
        base = {
            "backstage.io/source-location": self.source_location(rel, is_dir),
            f"{ANNOTATION_PREFIX}/apm-package": f"{self.apm['name']}@{self.apm['version']}",
            f"{ANNOTATION_PREFIX}/eval-score": eval_annotation(self.score),
        }
        base.update({f"{ANNOTATION_PREFIX}/{k}": v for k, v in extra.items()})
        return base

    def source_link(self, rel: str, is_dir: bool) -> dict:
        return {
            "url": self.source_url(rel, is_dir),
            "title": "Source",
            "type": "source",
        }

    # Entities ---------------------------------------------------------------

    def ai_resource(self, name: str, description: str, rel: str, is_dir: bool,
                    categories: list[str], extra_spec: dict, extra_ann: dict) -> dict:
        spec = {
            "type": "skill",
            "lifecycle": LIFECYCLE,
            "owner": self.owner,
            "system": self.system,
            "disciplines": list(DISCIPLINES),
            "categories": list(categories),
            "agents": list(self.agents),
        }
        spec.update(extra_spec)
        return {
            "apiVersion": "backstage.io/v1alpha1",
            "kind": "AiResource",
            "metadata": {
                "name": name,
                "title": name,
                "description": description,
                "tags": list(self.tags),
                "annotations": self.annotations(rel, is_dir, **extra_ann),
                "links": [self.source_link(rel, is_dir)],
            },
            "spec": spec,
        }

    def skill_entities(self) -> list[dict]:
        entities = []
        for skill_dir in sorted(p for p in (self.pack / ".apm" / "skills").iterdir() if p.is_dir()):
            fm = read_frontmatter(skill_dir / "SKILL.md")
            if fm["name"] != skill_dir.name:
                raise GenerateError(f"{skill_dir}: frontmatter name {fm['name']!r} != directory")
            extra = {"license": str(fm.get("license") or self.apm.get("license", "UNLICENSED"))}
            if fm.get("allowed-tools"):
                extra["allowedTools"] = str(fm["allowed-tools"])
            entities.append(self.ai_resource(
                name=skill_dir.name,
                description=str(fm["description"]).strip(),
                rel=f".apm/skills/{skill_dir.name}",
                is_dir=True,
                categories=SKILL_CATEGORIES,
                extra_spec=extra,
                extra_ann={},
            ))
        return entities

    def agent_entities(self) -> list[dict]:
        entities = []
        for agent_file in sorted((self.pack / ".apm" / "agents").glob("*.agent.md")):
            fm = read_frontmatter(agent_file)
            expected = agent_file.name[: -len(".agent.md")]
            if fm["name"] != expected:
                raise GenerateError(f"{agent_file}: frontmatter name {fm['name']!r} != file name")
            tools = str(fm.get("tools") or "")
            servers = sorted(set(MCP_TOOL_RE.findall(tools)))
            unknown = [s for s in servers if s not in self.mcp_servers]
            if unknown:
                raise GenerateError(
                    f"{agent_file}: references MCP servers not declared in apm.yml: {unknown}"
                )
            extra_ann = {"mcp-servers": ",".join(servers)} if servers else {}
            if fm.get("model"):
                extra_ann["agent-model"] = str(fm["model"])
            entities.append(self.ai_resource(
                name=expected,
                description=str(fm["description"]).strip(),
                rel=f".apm/agents/{agent_file.name}",
                is_dir=False,
                categories=AGENT_CATEGORIES,
                extra_spec={"license": str(self.apm.get("license", "UNLICENSED"))},
                extra_ann=extra_ann,
            ))
        return entities

    def mcp_entities(self) -> list[dict]:
        entities = []
        for name, dep in sorted(self.mcp_servers.items()):
            transport = str(dep.get("transport", "stdio"))
            if "url" in dep:
                url = str(dep["url"])
            else:
                url = " ".join([str(dep.get("command", ""))] + [str(a) for a in dep.get("args", [])]).strip()
            if not url:
                raise GenerateError(f"apm.yml: mcp dependency {name!r} has neither url nor command")
            entities.append({
                "apiVersion": "backstage.io/v1alpha1",
                "kind": "API",
                "metadata": {
                    "name": name,
                    "title": f"{name} MCP server",
                    "description": (
                        f"MCP server declared as a dependency of the {self.apm['name']} "
                        f"pack in apm.yml ({transport} transport)."
                    ),
                    "tags": list(self.tags) + ["mcp"],
                    "annotations": self.annotations("apm.yml", False),
                    "links": [self.source_link("apm.yml", False)],
                },
                "spec": {
                    "type": "mcp-server",
                    "lifecycle": LIFECYCLE,
                    "owner": self.owner,
                    "system": self.system,
                    "remotes": [{"type": transport, "url": url}],
                    # Base API schema requires a definition; keep the pack's own
                    # declaration so instances without the mcp-server model still accept it.
                    "definition": json.dumps(dep, sort_keys=True, indent=2),
                },
            })
        return entities

    def system_entity(self) -> dict:
        return {
            "apiVersion": "backstage.io/v1alpha1",
            "kind": "System",
            "metadata": {
                "name": self.system,
                "title": f"{self.system} {self.apm['version']}",
                "description": f"{str(self.apm['description']).strip()} {eval_summary(self.score)}",
                "tags": list(self.tags),
                "annotations": self.annotations("", True),
                "links": [
                    self.source_link("", True),
                    {"url": self.score["source"], "title": "Eval gate report", "type": "eval"},
                ],
            },
            "spec": {"owner": self.owner},
        }

    def entities(self) -> list[dict]:
        return [self.system_entity(), *self.skill_entities(), *self.agent_entities(), *self.mcp_entities()]

    def skills_index(self) -> dict:
        skills = []
        for skill_dir in sorted(p for p in (self.pack / ".apm" / "skills").iterdir() if p.is_dir()):
            fm = read_frontmatter(skill_dir / "SKILL.md")
            skills.append({
                "name": skill_dir.name,
                "description": str(fm["description"]).strip(),
                "files": list_files(skill_dir),
            })
        return {"skills": skills}


def render_yaml(entities: list[dict]) -> str:
    docs = [
        yaml.safe_dump(e, sort_keys=False, allow_unicode=True, width=100)
        for e in entities
    ]
    return GENERATED_HEADER + "---\n".join(docs)


def render_json(data: dict) -> str:
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def outputs(pack: Path, sha: str, pack_rel: str | None = None) -> dict[Path, str]:
    catalog = Catalog(pack, sha, pack_rel)
    return {
        pack / "catalog-info.yaml": render_yaml(catalog.entities()),
        pack / ".well-known" / "skills" / "index.json": render_json(catalog.skills_index()),
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--check", action="store_true", help="fail if the committed files drift")
    parser.add_argument("--pack", type=Path, default=DEFAULT_PACK, help="pack directory")
    parser.add_argument("--sha", help="provenance commit sha (skips git)")
    parser.add_argument("--allow-dirty", action="store_true", help="generate with uncommitted pack sources")
    parser.add_argument("--pack-rel", help="pack path inside the repository for source-location URLs")
    args = parser.parse_args(argv)

    pack = args.pack.resolve()
    try:
        if args.sha:
            sha = args.sha
            if not SHA_RE.fullmatch(sha):
                raise GenerateError(f"--sha must be a 40 character hex sha, got {sha!r}")
        elif args.check:
            sha = committed_sha(pack)
            verify_sources_match_sha(pack, sha)
        else:
            sha = resolve_sha(pack, args.allow_dirty)
        generated = outputs(pack, sha, args.pack_rel)
    except (GenerateError, yaml.YAMLError, json.JSONDecodeError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    drift = False
    for path, content in generated.items():
        rel = path.relative_to(pack).as_posix()
        if args.check:
            current = path.read_text(encoding="utf-8") if path.is_file() else ""
            if current != content:
                drift = True
                print(f"drift: {rel} differs from the generated output", file=sys.stderr)
                sys.stderr.writelines(difflib.unified_diff(
                    current.splitlines(True), content.splitlines(True),
                    fromfile=f"committed/{rel}", tofile=f"generated/{rel}",
                ))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
            print(f"wrote {rel} (provenance {sha[:12]})")
    if drift:
        print("run scripts/generate-backstage-catalog and commit the result", file=sys.stderr)
        return 1
    if args.check:
        print(f"catalog in sync with pack sources at {sha[:12]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
