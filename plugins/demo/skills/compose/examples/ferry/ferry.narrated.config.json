{
  "name": "skerry-ferries-demo",
  "takes": "./takes",
  "out": "./compose-narrated",
  "theme": {
    "bg": "#F4F1EA",
    "surface": "#FFFFFF",
    "accent": "#0B6E4F",
    "highlight": "#C2410C",
    "text": "#12241E",
    "muted": "#5B6B63",
    "fonts": {
      "display": {
        "file": "fonts/fraunces-700.woff2",
        "family": "Fraunces",
        "weight": "600 700"
      },
      "body": {
        "file": "fonts/plex-500.woff2",
        "family": "IBM Plex Sans",
        "weight": "500 600"
      }
    }
  },
  "cards": {
    "title": {
      "kicker": "Service walkthrough",
      "title": "Skerry Ferries, live board",
      "sub": "One crossing, from the pier board to the <b>fare table</b>",
      "dur": 3,
      "narration": "Skerry Ferries puts the whole crossing on one live board."
    },
    "end": {
      "kicker": "Skerry Ferries",
      "title": "Sail informed",
      "sub": "Departures, deck space and <b>fares</b> in one board",
      "dur": 3,
      "narration": "Sail informed, with Skerry Ferries."
    }
  },
  "chapters": [
    {
      "name": "departures",
      "title": "The live board",
      "persona": "Foot passenger · Mairi",
      "narration": {
        "intro": "Start at the pier board.",
        "marks": [
          "The {@two}two twenty sailing is running twelve minutes late.",
          "Only six {@cars}cars can still get on board.",
          "All four sailings, each with its {@current}current status."
        ]
      }
    },
    {
      "name": "fares",
      "title": "What it costs",
      "persona": "Foot passenger · Mairi",
      "labels": [
        "Single and return per ticket",
        "Resident fare needs proof"
      ],
      "narration": {
        "intro": "Then check what it costs.",
        "marks": [
          "Every {@ticket}ticket lists a single and a return fare.",
          "The island resident fare needs {@proof}proof of address."
        ]
      }
    }
  ],
  "audio": {
    "captions": {
      "burn": true
    }
  }
