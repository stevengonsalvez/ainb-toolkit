  "license": "Apache-2.0",
  "keywords": [
    "orchestration",
    "orca",
    "lanes",
    "handover"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Orchestrate",
    "shortDescription": "Adopt, tick, gate merges and hand over a programme of agent lanes",
    "category": "orchestration",
    "capabilities": [
      "Instructions"
    ],
    "defaultPrompt": [
      "orchestrate:takeover <programme>"
    ]
  }
